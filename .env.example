# Copy to .env (project root or backend/) and adjust. Real environment variables win.

# Leave empty to use a random key that is generated once into backend/.secret_key.
DJANGO_SECRET_KEY=

# Only true on your development machine.
DJANGO_DEBUG=false

# Host names/IPs the server is reached under, comma separated, e.g.
# DJANGO_ALLOWED_HOSTS=smarthome.local,192.168.178.50,localhost
DJANGO_ALLOWED_HOSTS=*

# Only needed for the Angular dev server (ng serve).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Set to false once every WG member has an account.
DJANGO_ALLOW_REGISTRATION=true

# Rate limits for login and sign-up/e-mail check (per client IP).
DJANGO_LOGIN_RATE=10/min
DJANGO_AUTH_RATE=30/min

# --- HTTPS (only once a reverse proxy with a certificate is in front) ---
# DJANGO_HTTPS=true
# DJANGO_SSL_REDIRECT=true
# Browsers remember HSTS; start with 3600 and raise to 31536000 when all works.
# DJANGO_HSTS_SECONDS=3600
# DJANGO_CSRF_TRUSTED_ORIGINS=https://smarthome.example.de
