+<div class="modal-backdrop" (click)="close()">
+    <div class="modal-panel links-panel" (click)="$event.stopPropagation()" aria-labelledby="links-title" appDialog
+        (dialogDismiss)="close()">
+        <div class="modal-head">
+            <div>
+                <h3 id="links-title">Kalender</h3>
+                <p class="links-subtitle">Gemeinsame Kalender, Outlook &amp; Co., Stundenpläne und der WG-Kalender
+                    unterwegs.</p>
+            </div>
+            <button class="modal-close" (click)="close()" aria-label="Schliessen">✕</button>
+        </div>
+        <div class="segmented links-tabs" role="tablist" aria-label="Bereich">
+            <button type="button" role="tab" [class.active]="tab === 'shared'" [attr.aria-selected]="tab === 'shared'"
+                (click)="tab = 'shared'">Gemeinsam</button>
+            <button type="button" role="tab" [class.active]="tab === 'linked'" [attr.aria-selected]="tab === 'linked'"
+                (click)="tab = 'linked'">Einblenden</button>
+            <button type="button" role="tab" [class.active]="tab === 'feed'" [attr.aria-selected]="tab === 'feed'"
+                (click)="tab = 'feed'">Abonnieren</button>
+        </div>
+
+        <div class="modal-body">
+            @if (loadError) { <div class="form-feedback" role="alert">{{ loadError }}</div> }
+
+            @switch (tab) {
+            <!-- ── Shared calendars inside the app ──────────────────────────────── -->
+            @case ('shared') {
+            <section class="links-section" aria-labelledby="shared-title">
+                <h4 id="shared-title">Gemeinsame Kalender</h4>
+                <p class="muted">Für einen Teil der WG, z. B. «Paar», «Band» oder «Velotour». Alle Mitglieder sehen die
+                    Termine und können sie eintragen und ändern. Die anderen sehen nichts davon.</p>
+                @if (sharedError) { <div class="form-feedback" role="alert">{{ sharedError }}</div> }
+                @for (calendar of shared; track calendar.id) {
+                @if (sharedForm?.id !== calendar.id) {
+                <article class="linked-row">
+                    <span class="dot" [style.background]="calendar.color" aria-hidden="true"></span>
+                    <div class="linked-main">
+                        <strong>{{ calendar.name }}</strong>
+                        <small>{{ calendar.memberNames.join(', ') }}</small>
+                    </div>
+                    <div class="row-actions">
+                        <button class="btn-ghost btn-sm" (click)="editShared(calendar)">Bearbeiten</button>
+                        <button class="btn-ghost btn-sm" (click)="leaveShared(calendar)">Austreten</button>
+                        <button class="btn-ghost btn-sm" [class.danger]="confirmDeleteShared === calendar.id"
+                            (click)="deleteShared(calendar)">{{ confirmDeleteShared === calendar.id ?
+                            'Mit allen Terminen löschen?' : 'Löschen' }}</button>
+                    </div>
+                </article>
+                }
+                }
+                @if (sharedForm; as f) {
+                <form class="link-form" (ngSubmit)="saveShared()">
