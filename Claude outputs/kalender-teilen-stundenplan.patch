+  border-radius: 999px;
+  border: 1px solid var(--color-card-border);
+  background: var(--color-surface);
+  color: var(--color-text);
+  font-size: .84rem;
+  cursor: pointer;
+}
+
+.person-chip.selected {
+  border-color: var(--color-accent-border);
+  background: var(--color-accent-soft);
+  color: var(--color-accent);
+  font-weight: 600;
+}
+
+.person-chip.selected::before {
+  content: '✓ ';
+}
+
+.add-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.source-switch,
+.audience-switch {
+  align-self: flex-start;
+}
+
+.field-label {
+  font-size: .75rem;
+  color: var(--color-muted);
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: .04em;
+}
+
+.file-drop {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  align-items: center;
+  justify-content: center;
+  padding: 18px;
+  border: 1px dashed var(--color-accent-border);
+  border-radius: 12px;
+  background: var(--color-surface-soft);
+  text-align: center;
+  cursor: pointer;
+}
+
+.file-drop:focus-within {
+  outline: 2px solid var(--color-accent);
+  outline-offset: 2px;
+}
+
+.file-drop input,
+.file-btn input {
+  position: absolute;
+  inset: 0;
+  opacity: 0;
+  cursor: pointer;
+}
+
+.file-drop small {
+  color: var(--color-muted);
+  font-size: .8rem;
+}
+
+.file-btn {
+  position: relative;
+  overflow: hidden;
+  cursor: pointer;
+}
+
+.muted.small {
+  font-size: .8rem;
+  margin: 0;
+}
+
+@media (max-width: 599px) {
+  .links-tabs[class] {
+    margin: 10px 16px 0;
+    align-self: stretch;
+    display: flex;
+    flex-wrap: nowrap;
+  }
+
+  .links-tabs[class] > button {
+    flex: 1;
+    min-width: 0;
+    padding-inline: 6px;
+  }
+}
